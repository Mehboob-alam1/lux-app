{
  "name": "@lux/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "vendor:contracts": "node ../scripts/vendor-contracts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "node lib/scripts/seed.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage"
  },
  "dependencies": {
    "@lux/contracts": "file:./vendor/contracts",
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
