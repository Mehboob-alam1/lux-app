# Copy to .env.local / CI secrets. NEVER commit real values.

# Firebase (client — public identifiers only)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lux-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Emulator
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FUNCTIONS_EMULATOR=true
GCLOUD_PROJECT=lux-dev

# Payments: sandbox | stripe
PAYMENT_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Maps (optional)
GOOGLE_MAPS_API_KEY=
PLACES_API_KEY=
ROUTES_API_KEY=

# Notifications (optional fallback)
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=

# App Check
APPCHECK_ENFORCE=false

# Admin
ADMIN_REQUIRE_MFA=false
NEXT_PUBLIC_USE_EMULATORS=true
